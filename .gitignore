# ---- frp client runtime ----
frpc.exe
frpc
frpc.log
frpc-stdout.log
frpc-stderr.log

# ---- Secrets: never commit credentials ----
# frpc.toml holds the relay token and server address: copy the .template instead.
frpc.toml
.env
.env.*
*.pem
*.key
id_rsa*
id_ed25519*
credential*

# ---- Node / npm (only if you add tooling) ----
node_modules/
npm-debug.log*
package-lock.json

# ---- Logs ----
*.log
logs/

# ---- Editor / OS ----
.vscode/
.idea/
Thumbs.db
desktop.ini
*.swp

# ---- Local scratch ----
tmp/
temp/
*.bak-*

# ---- secrets / credentials (never commit) ----
secrets/
*register-key*
*.pfx
*.p12
ca-key.pem
gateway.env
# CA certs for phone install are safe to publish, but keep local copies out:
!ca-for-phone/*.cer
!ca-for-phone/*.crt
